# Unidad de systemd para Centinela Zeus.
# Copiar a /etc/systemd/system/zeus-ops.service y luego:
#   sudo systemctl daemon-reload && sudo systemctl enable --now zeus-ops
#
# Corre en el host (no dentro de Docker) a propósito: tiene que poder reiniciar
# contenedores sin morir con ellos. Escucha en 0.0.0.0:4900 (todas las interfaces)
# para que Traefik y el bot, que corren en Docker, puedan alcanzarla. La API NO
# pide contraseña: el puerto 4900 TIENE que quedar cerrado a internet con el
# cortafuegos (docs/INSTALACION.md, paso 4b). La contraseña del panel la pone
# Traefik (ver traefik-dynamic.example.yml).

[Unit]
Description=Centinela Zeus — servicio de control del servidor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/zeus-ops
ExecStart=/usr/bin/node /opt/zeus-ops/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Los datos (historial, evidencia, auditorías) viven aquí, fuera del código.
StateDirectory=zeus-ops

[Install]
WantedBy=multi-user.target
