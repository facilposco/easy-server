# Centinela Zeus — configuración del servidor (server.js)
# Copia este archivo a /opt/zeus-ops/.env y llénalo. Nunca subas el .env real a git.
# Cada variable dice quién la usa y si es obligatoria.

# ── Identidad del panel ──────────────────────────────────────────────────────
# Dominio público del panel, con https. Se usa para validar el origen de las
# peticiones POST (protección CSRF). Obligatorio.
PANEL_ORIGEN=https://panel.ejemplo.com
# IP pública del servidor, solo para mostrarla en la ficha del panel. Opcional.
SERVIDOR_IP=203.0.113.10

# ── Base de datos (MariaDB en el contenedor zeus-mariadb) ────────────────────
# Contraseña de root de MariaDB. La usan las auditorías, las sugerencias de
# índices, el respaldo diario y la prueba de restauración. Obligatorio.
MYSQL_ROOT_PASS=cambia-esto
# Nombre de la base de datos que Centinela vigila. Obligatorio.
DB_ESQUEMA=negocio

# ── WhatsApp (proveedor de la API de WhatsApp Business; el código de
#    referencia usa Kapso, ver docs/ARQUITECTURA.md para cambiarlo) ──────────
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_META_URL=https://api.kapso.ai/meta/whatsapp/v24.0
# Número del dueño que recibe los avisos, con código de país y sin "+".
WSP_DESTINO=57XXXXXXXXXX
# Plantilla aprobada por Meta para avisos fuera de la ventana de 24 h.
WSP_PLANTILLA=centinela_zeus
# Secreto con el que el bot firma sus webhooks (solo si usas el monitoreo sintético).
KAPSO_WEBHOOK_SECRET=

# ── Inteligencia artificial (Gemini, vía el Worker de Cloudflare) ───────────
# URL pública del Worker desplegado desde cloudflare-worker/ (sin barra final).
VIGILANTE_URL=https://vigilante-zeus.TU-CUENTA.workers.dev
# Debe ser IGUAL al secreto PROXY_SECRETO configurado en el Worker.
PROXY_SECRETO_GEMINI=
# Debe ser IGUAL al secreto TOKEN_PRUEBA del Worker (lo usa el simulacro de red).
TOKEN_PRUEBA_VIGILANTE=

# ── Confirmaciones por PIN desde WhatsApp ────────────────────────────────────
# PIN numérico que se pide antes de una acción delicada pedida por WhatsApp.
PIN_ACCION=
# PIN aparte para lanzar simulacros desde WhatsApp.
PIN_SIMULACRO=
